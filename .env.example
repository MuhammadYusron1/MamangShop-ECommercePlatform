# ============================================================
#  .env.example (root) — TEMPLATE for podman compose secrets
#  ============================================================
#  COPY this to `.env` (gitignored) and put your REAL values in:
#      cp .env.example .env
#
#  podman compose reads these variables when it sees ${VAR} in
#  compose.yaml. This keeps secrets OUT of git while letting the
#  containerized server use your real keys.
# ============================================================

# Your REAL Stripe test secret key (server side).
# Get one at https://dashboard.stripe.com/test/apikeys
# Replace the placeholder below — do NOT commit a real key.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY

# Optional Stripe webhook secret (for verifying webhooks).
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET
