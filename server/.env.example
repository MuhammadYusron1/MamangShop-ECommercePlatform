# ============================================================
#  server/.env.example — TEMPLATE for environment variables
#  ============================================================
#  COPY this file to `.env` and fill in REAL values:
#      cp .env.example .env
#
#  IMPORTANT: NEVER commit the real `.env` (it's gitignored).
#  This template is committed so other developers know which
#  variables are needed.
#
#  For the Stripe test keys used by this repo, create your own at:
#      https://dashboard.stripe.com/test/apikeys
# ============================================================

# --- Server ---
# Which port the API listens on.
PORT=5000

# Node environment: development | production
NODE_ENV=development

# --- Database ---
# Connection string. Under podman compose the host is the SERVICE
# name "mongo" (containers reach each other by service name).
# If you run MongoDB locally without containers, use:
#   mongodb://127.0.0.1:27017/mamangshop
MONGO_URI=mongodb://mongo:27017/mamangshop

# --- JWT (auth) ---
# Secret used to sign login tokens. Use a LONG random string in prod.
JWT_SECRET=mamangshop_dev_secret_change_me
# How long tokens stay valid, e.g. 7d = 7 days.
JWT_EXPIRES_IN=7d

# --- Stripe ---
# Your SECRET key (server only, never exposed to the browser).
# Get test keys at https://dashboard.stripe.com/test/apikeys
# Replace the placeholder below with YOUR key. Keep this value out of git.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY

# Webhook secret for verifying Stripe->our-server payment confirmations.
# Create a webhook endpoint in the Stripe dashboard pointed at
#   http://localhost:5000/api/checkout/webhook
# then copy the whsec_... value here.
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

# --- Client ---
# The URL the browser uses to reach the storefront. Stripe redirects
# users back to this host after payment.
CLIENT_URL=http://localhost:3000
