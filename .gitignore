# ============================================================
#  .gitignore — Mamang Shop E-Commerce Platform
#  ============================================================
#  This file tells Git which files and folders to IGNORE.
#  Anything listed here will NOT be tracked/committed/pushed.
#  It is essential for:
#    1. Keeping SECRETS out of git (API keys, passwords, tokens)
#    2. Keeping huge/generated files out (node_modules, build output)
#    3. Keeping machine-specific files out (editor configs, env files)
#
#  Learning note: a .gitignore is your FIRST line of security. Never
#  commit your real .env files — only commit the .env.example template.
# ============================================================

# ---------- Dependencies (generated by npm install) ----------
node_modules/
**/node_modules/

# ---------- Build output (generated by bundlers) ----------
dist/
**/dist/
build/

# ---------- Environment / Secret files ----------
# Real secrets NEVER get committed. We only commit the .env.example
# template which contains placeholder values and instructions.
.env
.env.local
.env.production
.env.development
**/.env
!**/.env.example

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Editor / OS files (machine-specific) ----------
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------- Vite / test coverage ----------
coverage/
*.tsbuildinfo

# ---------- Misc ----------
.cache/
.tmp/

# ---------- Agent tooling (local devenv, not part of the app) ----------
.agents/
skills-lock.json
